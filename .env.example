# ==========================================================================
# MODERN VILLAGE - ENVIRONMENT CONFIGURATION
# ==========================================================================

# Supabase Project Credentials (Optional - App runs with offline mock fallback if omitted)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# AI Priority Classification API (Optional - Rule-based fallback is active by default)
VITE_GEMINI_API_KEY=your-gemini-api-key

# Optional SMS Gateway (e.g. Fast2SMS / Twilio for citizen SMS notifications)
VITE_SMS_PROVIDER_API_KEY=your-sms-api-key
